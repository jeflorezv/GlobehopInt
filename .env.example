# ── AI Content ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# ── AI Images ────────────────────────────────────────────────────────────────
IDEOGRAM_API_KEY=YOUR_IDEOGRAM_KEY_HERE

# ── AI Video (Reels) ─────────────────────────────────────────────────────────
KLING_API_KEY=YOUR_KLING_ACCESS_KEY_HERE
KLING_API_SECRET=YOUR_KLING_SECRET_KEY_HERE
KLING_API_BASE_URL=https://api.klingai.com

# ── Airtable ─────────────────────────────────────────────────────────────────
AIRTABLE_API_KEY=patYOUR_AIRTABLE_PAT_HERE
AIRTABLE_BASE_ID=appYOUR_BASE_ID_HERE
AIRTABLE_TABLE_NAME=Contenido Instagram

# ── Instagram Graph API ───────────────────────────────────────────────────────
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_SYSTEM_USER_TOKEN=
INSTAGRAM_API_VERSION=v21.0

# ── Brand identity ────────────────────────────────────────────────────────────
# GlobeHop palette (Identity Kit 2026):
#   Blue (primary)  #44539D   ← default tint colour
#   Dark Blue       #1C2631
#   Mint Green      #67BB97
#   Red             #CF202C
#   White           #FFFFFF
LOGO_PATH=./assets/logo.png
LOGO_POSITION=southeast
BRAND_PRIMARY_COLOR=#44539D   # GlobeHop Blue — override with any palette hex above
BRAND_TINT_OPACITY=0.12       # float 0.0–1.0; 0.10–0.18 recommended range

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
WEBHOOK_SECRET=generate-a-strong-random-secret-here
RAILWAY_PUBLIC_URL=            # e.g. https://your-app.up.railway.app

# ── Alerts ───────────────────────────────────────────────────────────────────
ALERT_EMAIL=you@yourdomain.com          # fallback used for both from and to if specific vars not set
ALERT_FROM_EMAIL=noreply@yourdomain.com # optional: dedicated sender address
ALERT_TO_EMAIL=you@yourdomain.com       # optional: dedicated recipient address
SENDGRID_API_KEY=SG.YOUR_SENDGRID_KEY_HERE
